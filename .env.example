# Application Settings
APP_NAME=Smart Inbox Assistant
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:4200

# Gemini AI API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Database Settings (Oracle / SQLAlchemy)
# Option A: Full Database URL for Oracle DB
# DATABASE_URL=oracle+oracledb://app_user:secure_password@localhost:1521/?service_name=ORCLPDB1

# Option B: Individual Oracle Connection Parameters (Constructs URL automatically if USER & PASSWORD are set)
# ORACLE_USER=app_user
# ORACLE_PASSWORD=secure_password
# ORACLE_HOST=localhost
# ORACLE_PORT=1521
# ORACLE_SERVICE_NAME=ORCLPDB1

# Option C: Local Development / Testing Fallback
DATABASE_URL=sqlite:///./smart_inbox.db

# Email Settings (IMAP)
IMAP_SERVER=imap.example.com
IMAP_PORT=993
IMAP_USERNAME=test-inbox@example.com
IMAP_PASSWORD=your_imap_password
IMAP_USE_SSL=true
